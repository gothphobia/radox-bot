BOT_TOKEN=вставь_токен_от_BotFather
DEEPSEEK_API_KEY=вставь_ключ_deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com

# необязательно
TTS_VOICE=ru-RU-SvetlanaNeural
# small — хороший баланс для русского; base/tiny — если мало памяти
WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# MAX_TTS_CHARS=1500

# утренний брифинг и фоновые задачи памяти
BRIEFING_WEEKDAY_TIME=06:30
BRIEFING_WEEKEND_TIME=09:00
MEMORY_MODEL=deepseek-flash

# поиск: без ключа используется ddgs (DuckDuckGo), с ключом — Tavily
# TAVILY_API_KEY=вставь_ключ_tavily
